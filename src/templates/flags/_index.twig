{% extends '_layouts/cp' %}

{% import '_includes/forms' as forms %}

{% set title = 'Feature Flags'|t('feature-flags') %}
{% set selectedSubnavItem = 'flags' %}

{% block actionButton %}
    {% if currentUser.can('featureFlags:manage') %}
        <a href="{{ url('feature-flags/new') }}" class="btn submit add icon">
            {{ 'New Flag'|t('feature-flags') }}
        </a>
    {% endif %}
{% endblock %}

{% set canToggle = currentUser.can('featureFlags:toggle') or currentUser.can('featureFlags:manage') %}

{% block content %}
    {% if flags|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Name'|t('feature-flags') }}</th>
                    <th>{{ 'Type'|t('feature-flags') }}</th>
                    <th>{{ 'Status'|t('feature-flags') }}</th>
                    <th>{{ 'Rollout %'|t('feature-flags') }}</th>
                    <th>{{ 'Rules'|t('feature-flags') }}</th>
                    <th>{{ 'Expires'|t('feature-flags') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for flag in flags %}
                    <tr data-flag-id="{{ flag.id }}">
                        <td>
                            <a href="{{ url('feature-flags/' ~ flag.id) }}">
                                {{ flag.name }}
                            </a>
                            <div class="smalltext light"><code>{{ flag.handle }}</code></div>
                            {% if flag.description %}
                                <div class="smalltext light">{{ flag.description|truncate(80) }}</div>
                            {% endif %}
                        </td>
                        <td>{{ flag.flagType|capitalize }}</td>
                        <td>
                            <div class="flex" style="gap: 8px; align-items: center;">
                                {% if canToggle %}
                                    {{ forms.lightswitch({
                                        id: 'ff-toggle-' ~ flag.id,
                                        on: flag.enabled,
                                        small: true,
                                        containerAttributes: {
                                            data: { 'flag-id': flag.id },
                                            aria: { label: 'Toggle {name}'|t('feature-flags', { name: flag.name }) },
                                        },
                                    }) }}
                                {% endif %}
                                <span class="ff-status">
                                    <span class="status {{ flag.enabled ? 'active' : 'expired' }}"></span>
                                    <span class="ff-status-text">{{ flag.enabled ? 'Enabled'|t('feature-flags') : 'Disabled'|t('feature-flags') }}</span>
                                </span>
                            </div>
                        </td>
                        <td>{{ flag.rolloutPercentage is not null ? flag.rolloutPercentage ~ '%' : '—' }}</td>
                        <td>{{ flag.rules|length }}</td>
                        <td>
                            {% if flag.expiresAt %}
                                {{ flag.expiresAt|datetime('short') }}
                            {% else %}
                                <span class="light">&mdash;</span>
                            {% endif %}
                        </td>
                        <td class="thin">
                            <a class="delete icon formsubmit"
                               data-action="feature-flags/flags/delete"
                               data-confirm="{{ 'Are you sure you want to delete this flag?'|t('feature-flags') }}"
                               data-redirect="{{ cpUrl('feature-flags')|hash }}"
                               data-param="flagId" data-value="{{ flag.id }}"
                               role="button"
                               title="{{ 'Delete'|t('app') }}"></a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch">{{ 'No feature flags yet.'|t('feature-flags') }}</p>
    {% endif %}

    {% if canToggle %}
    {% js %}
    (function() {
        const enabledText = {{ 'Enabled'|t('feature-flags')|json_encode|raw }};
        const disabledText = {{ 'Disabled'|t('feature-flags')|json_encode|raw }};
        const savedText = {{ 'Flag toggled.'|t('feature-flags')|json_encode|raw }};
        const failedText = {{ 'Could not toggle flag.'|t('feature-flags')|json_encode|raw }};

        $('.lightswitch[data-flag-id]').each(function() {
            const $switch = $(this);
            const flagId = $switch.data('flag-id');
            const $status = $switch.closest('td').find('.ff-status');

            $switch.on('change', function() {
                const lightswitch = $switch.data('lightswitch');
                const enabled = lightswitch.on;

                Craft.sendActionRequest('POST', 'feature-flags/flags/toggle', {
                    data: { flagId: flagId, enabled: enabled ? 1 : 0 },
                }).then(function() {
                    $status.find('.status').toggleClass('active', enabled).toggleClass('expired', !enabled);
                    $status.find('.ff-status-text').text(enabled ? enabledText : disabledText);
                    Craft.cp.displayNotice(savedText);
                }).catch(function() {
                    // Revert without firing another change event (the `true` arg skips onChange).
                    enabled ? lightswitch.turnOff(true) : lightswitch.turnOn(true);
                    Craft.cp.displayError(failedText);
                });
            });
        });
    })();
    {% endjs %}
    {% endif %}

{% endblock %}
